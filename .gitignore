# Python build / test caches (regenerable, never part of the submission)
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/

# Source and cleaned data stay on the local machine; only the .gitkeep markers
# and the provenance manifest are versioned (see data/manifest.yaml).
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Row-level audit tables stay local; only aggregate summaries are versioned.
results/provenance_audit/*.csv
results/cleaning_quality_audit/*.csv

# Office lock files and scratch builds
~$*
.tmp*/
